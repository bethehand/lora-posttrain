{"id": "vwap_gap_longer_up", "family": "close_vwap", "key": "return", "direction": 1, "zh": "收盘价持续高于成交均价的币，后面继续强", "en": "Coins that keep closing above their average traded price stay strong.", "source": "base: close_vwap", "reference": "(Factor('close').safe_div(Factor('quote_volume').safe_div(Factor('volume'))) - 1).ts_mean(window=20, min_periods=16)", "split": "train"}
{"id": "beat_market_days_up", "family": "market_relative", "key": "return", "direction": 1, "zh": "过去二十天跑赢大盘的天数多的币，后面继续强", "en": "Coins that beat the market on many of the last twenty days stay strong.", "source": "generic", "reference": "((Factor('close').safe_div(Factor('close').lag(periods=1)) - 1).demean() > 0).ts_mean(window=20, min_periods=16)", "split": "heldout"}
